{
  "$comment": "Known answers every Lumber plugin is tested against, whatever its language. Lumber-Kit's own tests check each one against its TypeScript (buildLogPayload, splitApiKey, logDeliveryOutcome, logRetryDelayMs, the constants) and Node's crypto, so these can't drift from the kit. An absent key means absent: JSON has no undefined, and null data values are left out like missing ones.",
  "constants": {
    "defaultEndpoint": "https://api.lumber.infinitetoken.com",
    "ingestPath": "/logs",
    "keyVersion": 1,
    "keyBytes": 32,
    "nonceBytes": 12,
    "tagBytes": 16,
    "levels": { "debug": 0, "info": 1, "warn": 2, "error": 3, "fatal": 4 },
    "delivery": { "maxAttempts": 5, "baseDelayMs": 1000, "maxDelayMs": 30000, "pauseMs": 3600000 }
  },
  "apiKeys": [
    {
      "name": "token and encryption key",
      "apiKey": "3f9c0e7a1b2d4c6e8f0a1b2c3d4e5f60.AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
      "token": "3f9c0e7a1b2d4c6e8f0a1b2c3d4e5f60",
      "encryptionKey": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="
    },
    {
      "name": "surrounding whitespace, as pasted from a terminal",
      "apiKey": "  3f9c0e7a1b2d4c6e8f0a1b2c3d4e5f60.AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=\n",
      "token": "3f9c0e7a1b2d4c6e8f0a1b2c3d4e5f60",
      "encryptionKey": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="
    },
    {
      "name": "a bare token carries no encryption key",
      "apiKey": "3f9c0e7a1b2d4c6e8f0a1b2c3d4e5f60",
      "token": "3f9c0e7a1b2d4c6e8f0a1b2c3d4e5f60",
      "encryptionKey": null
    },
    {
      "name": "empty",
      "apiKey": "",
      "token": "",
      "encryptionKey": null
    }
  ],
  "encryption": [
    {
      "name": "ascii",
      "key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
      "nonce": "oKGio6Slpqeoqaqr",
      "plaintext": "{\"level\":1,\"message\":\"Server started\",\"metadata\":{\"port\":3000}}",
