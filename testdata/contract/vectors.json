  "payloads": [
    {
      "name": "message alone",
      "level": 1,
      "message": "Server started",
      "payload": { "level": 1, "message": "Server started" }
    },
    {
      "name": "request and trace ids",
      "level": 3,
      "message": "Payment failed",
      "data": { "requestId": "req-123", "traceId": "trace-abc" },
      "payload": { "level": 3, "message": "Payment failed", "requestId": "req-123", "traceId": "trace-abc" }
    },
    {
      "name": "other keys become metadata",
      "level": 1,
      "message": "User action",
      "data": { "userId": "123", "action": "login", "order": { "id": 7, "total": 12.5, "items": ["a", "b"] } },
      "payload": { "level": 1, "message": "User action", "metadata": { "userId": "123", "action": "login", "order": { "id": 7, "total": 12.5, "items": ["a", "b"] } } }
    },
    {
      "name": "explicit metadata wins over other keys",
      "level": 2,
      "message": "Rate limit approaching",
      "data": { "version": 1, "region": "us", "metadata": { "version": 2, "build": "b7" } },
      "payload": { "level": 2, "message": "Rate limit approaching", "metadata": { "version": 2, "region": "us", "build": "b7" } }
    },
    {
      "name": "metadata alone",
      "level": 1,
      "message": "Cache warmed",
      "data": { "metadata": { "entries": 512 } },
      "payload": { "level": 1, "message": "Cache warmed", "metadata": { "entries": 512 } }
    },
    {
      "name": "automatic context alone",
      "level": 0,
      "message": "Cache miss",
      "autoContext": { "pid": 4242, "hostname": "web-1" },
      "payload": { "level": 0, "message": "Cache miss", "context": { "pid": 4242, "hostname": "web-1" } }
    },
    {
      "name": "the call's context over the automatic context",
      "level": 1,
      "message": "Job done",
      "autoContext": { "pid": 4242, "hostname": "web-1", "env": "production" },
      "data": { "context": { "hostname": "worker-3", "code": "jobs/billing.py", "line": 42 } },
      "payload": { "level": 1, "message": "Job done", "context": { "pid": 4242, "hostname": "worker-3", "env": "production", "code": "jobs/billing.py", "line": 42 } }
    },
    {
      "name": "context with no automatic context",
      "level": 1,
      "message": "Job done",
      "autoContext": {},
      "data": { "context": { "code": "app.ts" } },
      "payload": { "level": 1, "message": "Job done", "context": { "code": "app.ts" } }
    },
    {
      "name": "a context that isn't an object is a metadata key",
      "level": 1,
      "message": "Invoice sent",
      "data": { "context": "billing" },
      "payload": { "level": 1, "message": "Invoice sent", "metadata": { "context": "billing" } }
    },
    {
      "name": "metadata that isn't an object is a metadata key",
      "level": 1,
      "message": "Batch",
      "data": { "metadata": [1, 2, 3] },
      "payload": { "level": 1, "message": "Batch", "metadata": { "metadata": [1, 2, 3] } }
    },
    {
      "name": "a null context and metadata are left out",
      "level": 1,
      "message": "Nothing extra",
      "data": { "context": null, "metadata": null },
      "payload": { "level": 1, "message": "Nothing extra" }
    },
    {
      "name": "a level key in the data is metadata, never the log's level",
      "level": 3,
      "message": "Disk nearly full",
      "data": { "level": "high", "message": "ignored" },
      "payload": { "level": 3, "message": "Disk nearly full", "metadata": { "level": "high", "message": "ignored" } }
    },
    {
      "name": "everything",
      "level": 4,
      "message": "DB connection lost ☠",
      "autoContext": { "pid": 1, "hostname": "db-proxy" },
      "data": { "requestId": "r1", "traceId": "t1", "context": { "method": "connect" }, "metadata": { "retries": 3 }, "host": "10.0.0.5" },
      "payload": { "level": 4, "message": "DB connection lost ☠", "requestId": "r1", "traceId": "t1", "context": { "pid": 1, "hostname": "db-proxy", "method": "connect" }, "metadata": { "host": "10.0.0.5", "retries": 3 } }
    }
